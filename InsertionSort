#include <iostream>
using namespace std;
int a[1000];
void InsertionSort(int a[], int n)
{
	int pos, x;
	for (int i = 1; i < n; i++)
	{
		x = a[i];
		pos = i - 1;
		while (pos >= 0 && a[pos] > x)
		{
			a[pos + 1] = a[pos];
			pos--;
		}
		a[pos + 1] = x;
	}
}
int main()
{
	int n;
	cin >> n;
	for (int i = 0; i < n; i++)
	{
		cin >> a[i];
	}
	InsertionSort(a, n);
	for (int i = 0; i < n; i++)
	{
		cout << a[i] << " ";
	}
}
